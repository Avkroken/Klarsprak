{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klarsprak",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  // Domänen ägs av den här filen, inte av dashboarden. En custom domain som
  // bara konfigurerats för hand återskapas inte av `wrangler deploy` — och
  // försvinner den, går sajten ner utan att något i repot ändrats. Exakt det
  // hände 2026-08-17: workern var deployad och frisk, men klarsprak.denied.se
  // saknade DNS-post helt (Cloudflare svarade NODATA) och var oåtkomlig.
  // Samma mönster som politiker-webapp/app/wrangler.jsonc.
  "routes": [
    {
      "pattern": "klarsprak.denied.se",
      "custom_domain": true
    },
    {
      // klarspråk.denied.se i punycode. .se tillåter åäö, och sajten HETER
      // Klarspråk — folk skriver namnet med å. Utan den här posten fick de
      // ett uppslagsfel. Servern kanoniserar till ASCII-namnet (301 i
      // worker.js) så att sessioner, cookies och länkdelning inte splittras
      // på två värdnamn.
      "pattern": "xn--klarsprk-g0a.denied.se",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klarsprak-db",
      "database_id": "a8117d9d-a65d-430d-a8a2-9b4ef3fd9e2f"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
