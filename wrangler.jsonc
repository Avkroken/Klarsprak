{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klarsprak",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "TURNSTILE_HOSTNAMES": "klarsprak.denied.se,xn--klarsprk-g0a.denied.se" },
  "routes": [
    { "pattern": "klarsprak.denied.se", "custom_domain": true },
    { "pattern": "xn--klarsprk-g0a.denied.se", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Static Assets är annars asset-first. Utan detta kan t.ex. / och
    // /varfor.html serveras direkt utan att worker.js körs, vilket skulle
    // kringgå host-redirecten för IDN-aliaset. Worker-koden skickar sedan
    // vanliga anrop vidare till ASSETS.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klarsprak-db-eu",
      "database_id": "7891c6c7-0d4b-4e23-b2d8-d3eaaabdcfce"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  }
}
